# Same key used by the web app — required unless DEMO_MODE=1
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# DEMO_MODE=1

# --- MCP server specific ---
MCP_PORT=4000
# Comma-separated bearer tokens accepted on /mcp and /metrics.
# Leave unset for local/demo use (server logs a warning and stays open).
MCP_API_KEYS=demo-key-change-me,another-client-key

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
